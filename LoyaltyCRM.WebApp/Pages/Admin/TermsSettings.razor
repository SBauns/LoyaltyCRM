@page "/admin/terms"
@layout AdminLayout

@using System.Net.Http.Headers
@using System.Text.Json
@using LoyaltyCRM.WebApp.Locales
@using LoyaltyCRM.WebApp.Shared

@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthService AuthService
@inject IStringLocalizer<Resources> L

<h4 class="text-center mb-3">@L["TermsSettings.Title"]</h4>

<div class="mb-3 d-flex gap-2 justify-content-center align-items-center flex-wrap">
    <select class="form-select form-select-sm w-auto"
            value="@(selectedVersionId?.ToString() ?? string.Empty)"
            @onchange="OnVersionSelected">
        <option value="">@L["TermsVersions.SelectPrompt"]</option>
        @foreach (TermsVersionItem version in versions)
        {
            <option value="@version.Id">@FormatVersionLabel(version)</option>
        }
    </select>

    <button class="btn btn-sm btn-outline-primary" @onclick="RequestMakeCurrent" disabled="@(!IsVersionSelected)">
        @L["TermsVersions.MakeCurrent"]
    </button>
    <button class="btn btn-sm btn-outline-danger" @onclick="RequestDeleteVersion" disabled="@(!IsVersionSelected)">
        @L["TermsVersions.Delete"]
    </button>

    <button class="btn btn-sm @(BoldActive ? "btn-primary" : "btn-outline-secondary")" @onclick="ExecBold">
        @L["TermsEditor.Bold"]
    </button>
    <button class="btn btn-sm @(BulletsActive ? "btn-primary" : "btn-outline-secondary")" @onclick="ExecBullets">
        @L["TermsEditor.Bullets"]
    </button>
    <button class="btn btn-sm btn-primary" @onclick="SaveTermsToServer">
        @L["TermsEditor.Save"]
    </button>
    <button class="btn btn-sm btn-outline-danger" @onclick="RequestClearTerms">
        @L["TermsEditor.Clear"]
    </button>
</div>

@if (!string.IsNullOrEmpty(editorMessage))
{
    <div class="alert mt-2 @(editorSuccess ? "alert-success" : "alert-danger") text-center">
        @editorMessage
    </div>
}

<div id="termsEditor"
     contenteditable="true"
     class="border rounded p-3"
     style="min-height:240px; overflow:auto;">
</div>

<ConfirmDialog Visible="showConfirmation"
               Title="@ConfirmationTitle"
               Message="@ConfirmationMessage"
               Danger="@IsConfirmationDangerous"
               ConfirmText="@L["Common.Confirm"]"
               CancelText="@L["Common.Cancel"]"
               OnConfirm="OnConfirmationConfirm"
               OnCancel="OnConfirmationCancel" />

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private enum PendingConfirmation
    {
        None,
        ClearEditor,
        LoadVersion,
        DeleteVersion,
        SetCurrentVersion
    }

    private sealed class TermsVersionItem
    {
        public int Id { get; set; }
        public DateTime CreatedAtUtc { get; set; }
        public bool IsCurrent { get; set; }
    }

    private List<TermsVersionItem> versions = new();
    private int? selectedVersionId;
    private string lastLoadedHtml = string.Empty;

    private string editorMessage = string.Empty;
    private bool editorSuccess;

    private bool BoldActive;
    private bool BulletsActive;

    private string html = string.Empty;

    private PendingConfirmation pendingConfirmation = PendingConfirmation.None;
    private bool showConfirmation;

    private bool IsVersionSelected => selectedVersionId is not null;

    private bool IsConfirmationDangerous =>
        pendingConfirmation is PendingConfirmation.DeleteVersion or PendingConfirmation.ClearEditor;

    private string ConfirmationTitle => pendingConfirmation switch
    {
        PendingConfirmation.ClearEditor => L["TermsEditor.ConfirmClearTitle"],
        PendingConfirmation.LoadVersion => L["TermsVersions.UnsavedChangesTitle"],
        PendingConfirmation.DeleteVersion => L["TermsVersions.ConfirmDeleteTitle"],
        PendingConfirmation.SetCurrentVersion => L["TermsVersions.ConfirmCurrentTitle"],
        _ => string.Empty
    };

    private string ConfirmationMessage => pendingConfirmation switch
    {
        PendingConfirmation.ClearEditor => L["TermsEditor.ConfirmClearMessage"],
        PendingConfirmation.LoadVersion => L["TermsVersions.UnsavedChangesMessage"],
        PendingConfirmation.DeleteVersion => L["TermsVersions.ConfirmDeleteMessage"],
        PendingConfirmation.SetCurrentVersion => L["TermsVersions.ConfirmCurrentMessage"],
        _ => string.Empty
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetTermsAsync();
            await ReloadVersionsAsync();
        }
    }

    private async Task GetTermsAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(html))
            {
                HttpResponseMessage response = await Http.GetAsync("/api/terms");
                if (response.IsSuccessStatusCode)
                {
                    html = await response.Content.ReadAsStringAsync();
                }
            }

            if (!string.IsNullOrWhiteSpace(html))
            {
                await JS.InvokeVoidAsync("authHelpers.setEditorContent", "termsEditor", html);
                lastLoadedHtml = html;
            }
        }
        catch
        {
        }
    }

    private async Task ReloadVersionsAsync()
    {
        try
        {
            using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Get, "/api/terms/history");
            using HttpResponseMessage response = await SendAuthorizedAsync(request);

            if (response.IsSuccessStatusCode)
            {
                string json = await response.Content.ReadAsStringAsync();
                versions = JsonSerializer.Deserialize<List<TermsVersionItem>>(json, JsonOptions) ?? new List<TermsVersionItem>();
                StateHasChanged();
            }
        }
        catch (Exception exception)
        {
            editorSuccess = false;
            editorMessage = $"{L["TermsEditor.SaveError"]} {exception.Message}";
        }
    }

    private async Task<HttpResponseMessage> SendAuthorizedAsync(HttpRequestMessage request)
    {
        string? token = await AuthService.GetTokenAsync();

        if (!string.IsNullOrEmpty(token))
        {
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }

        return await Http.SendAsync(request);
    }

    private async Task<bool> IsEditorDirtyAsync()
    {
        string currentContent = await JS.InvokeAsync<string>("authHelpers.getEditorContent", "termsEditor");
        return !string.Equals(currentContent, lastLoadedHtml, StringComparison.Ordinal);
    }

    private async Task OnVersionSelected(ChangeEventArgs arguments)
    {
        selectedVersionId = int.TryParse(arguments.Value?.ToString(), out int parsedId) ? parsedId : (int?)null;

        if (selectedVersionId is null)
        {
            return;
        }

        if (await IsEditorDirtyAsync())
        {
            pendingConfirmation = PendingConfirmation.LoadVersion;
            showConfirmation = true;
            return;
        }

        await LoadSelectedVersionAsync();
    }

    private async Task LoadSelectedVersionAsync()
    {
        if (selectedVersionId is not int versionId)
        {
            return;
        }

        try
        {
            using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Get, $"/api/terms/{versionId}");
            using HttpResponseMessage response = await SendAuthorizedAsync(request);

            if (response.IsSuccessStatusCode)
            {
                string versionHtml = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("authHelpers.setEditorContent", "termsEditor", versionHtml);
                lastLoadedHtml = versionHtml;

                editorSuccess = true;
                editorMessage = L["TermsVersions.VersionLoaded"];
            }
            else
            {
                editorSuccess = false;
                editorMessage = $"{(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception exception)
        {
            editorSuccess = false;
            editorMessage = $"{L["TermsEditor.SaveError"]} {exception.Message}";
        }
    }

    private void RequestClearTerms()
    {
        pendingConfirmation = PendingConfirmation.ClearEditor;
        showConfirmation = true;
    }

    private void RequestMakeCurrent()
    {
        if (selectedVersionId is null)
        {
            return;
        }

        pendingConfirmation = PendingConfirmation.SetCurrentVersion;
        showConfirmation = true;
    }

    private void RequestDeleteVersion()
    {
        if (selectedVersionId is null)
        {
            return;
        }

        pendingConfirmation = PendingConfirmation.DeleteVersion;
        showConfirmation = true;
    }

    private async Task OnConfirmationConfirm()
    {
        showConfirmation = false;
        PendingConfirmation action = pendingConfirmation;
        pendingConfirmation = PendingConfirmation.None;

        switch (action)
        {
            case PendingConfirmation.ClearEditor:
                await ClearEditorConfirmedAsync();
                break;
            case PendingConfirmation.LoadVersion:
                await LoadSelectedVersionAsync();
                break;
            case PendingConfirmation.DeleteVersion:
                await DeleteSelectedVersionAsync();
                break;
            case PendingConfirmation.SetCurrentVersion:
                await MakeSelectedVersionCurrentAsync();
                break;
        }
    }

    private void OnConfirmationCancel()
    {
        showConfirmation = false;

        // Reset the dropdown when a dirty-load was declined,
        // otherwise picking the same version again never fires the change event.
        if (pendingConfirmation == PendingConfirmation.LoadVersion)
        {
            selectedVersionId = null;
        }

        pendingConfirmation = PendingConfirmation.None;
    }

    private async Task ClearEditorConfirmedAsync()
    {
        await JS.InvokeVoidAsync("authHelpers.setEditorContent", "termsEditor", string.Empty);
        lastLoadedHtml = string.Empty;

        editorSuccess = true;
        editorMessage = L["TermsEditor.TermsCleared"];
    }

    private async Task MakeSelectedVersionCurrentAsync()
    {
        if (selectedVersionId is not int versionId)
        {
            return;
        }

        try
        {
            using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Put, $"/api/terms/{versionId}/current");
            using HttpResponseMessage response = await SendAuthorizedAsync(request);

            if (response.IsSuccessStatusCode)
            {
                selectedVersionId = null;

                editorSuccess = true;
                editorMessage = L["TermsVersions.CurrentSet"];

                await ReloadVersionsAsync();
            }
            else
            {
                editorSuccess = false;
                editorMessage = $"{(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception exception)
        {
            editorSuccess = false;
            editorMessage = $"{L["TermsEditor.SaveError"]} {exception.Message}";
        }
    }

    private async Task DeleteSelectedVersionAsync()
    {
        if (selectedVersionId is not int versionId)
        {
            return;
        }

        try
        {
            using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Delete, $"/api/terms/{versionId}");
            using HttpResponseMessage response = await SendAuthorizedAsync(request);

            if (response.IsSuccessStatusCode)
            {
                selectedVersionId = null;

                editorSuccess = true;
                editorMessage = L["TermsVersions.Deleted"];

                await ReloadVersionsAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                editorSuccess = false;
                editorMessage = L["TermsVersions.CannotDeleteCurrent"];
            }
            else
            {
                editorSuccess = false;
                editorMessage = $"{(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception exception)
        {
            editorSuccess = false;
            editorMessage = $"{L["TermsEditor.SaveError"]} {exception.Message}";
        }
    }

    private async Task SaveTermsToServer()
    {
        editorMessage = string.Empty;

        try
        {
            string content = await JS.InvokeAsync<string>("authHelpers.getEditorContent", "termsEditor");

            if (string.IsNullOrWhiteSpace(content))
            {
                editorSuccess = false;
                editorMessage = L["TermsEditor.CannotSaveEmpty"];
                return;
            }

            using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Put, "/api/terms")
            {
                Content = new StringContent(content, System.Text.Encoding.UTF8, "text/html")
            };

            using HttpResponseMessage response = await SendAuthorizedAsync(request);

            if (response.IsSuccessStatusCode)
            {
                editorSuccess = true;
                editorMessage = L["TermsEditor.SavedSuccessfully"];
                lastLoadedHtml = content;

                await ReloadVersionsAsync();
            }
            else
            {
                editorSuccess = false;
                editorMessage = $"{(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception exception)
        {
            editorSuccess = false;
            editorMessage = $"{L["TermsEditor.SaveError"]} {exception.Message}";
        }
    }

    private string FormatVersionLabel(TermsVersionItem version)
    {
        string suffix = version.IsCurrent ? $" ({L["TermsVersions.CurrentSuffix"]})" : string.Empty;
        return $"{version.CreatedAtUtc.ToLocalTime():yyyy-MM-dd HH:mm}{suffix}";
    }

    private async Task ExecBold()
    {
        await JS.InvokeAsync<bool>("authHelpers.execAndGetState", "bold", "termsEditor");
        await UpdateCommandStates();
    }

    private async Task ExecBullets()
    {
        await JS.InvokeAsync<bool>("authHelpers.execAndGetState", "insertUnorderedList", "termsEditor");
        await UpdateCommandStates();
    }

    private async Task UpdateCommandStates()
    {
        try
        {
            BoldActive = await JS.InvokeAsync<bool>(
                "authHelpers.queryCommandState",
                "bold",
                "termsEditor"
            );

            BulletsActive = await JS.InvokeAsync<bool>(
                "authHelpers.queryCommandState",
                "insertUnorderedList",
                "termsEditor"
            );

            StateHasChanged();
        }
        catch
        {
        }
    }
}