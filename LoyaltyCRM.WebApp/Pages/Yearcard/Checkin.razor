@page "/yearcard/checkin"
@inject YearcardService YearcardService
@using LoyaltyCRM.DTOs.Enums
@using LoyaltyCRM.DTOs.Requests.Checkin
@using LoyaltyCRM.WebApp.Components
@using LoyaltyCRM.WebApp.Locales
@inject IStringLocalizer<Resources> L

<div class="wrapper d-flex flex-column align-items-center justify-content-center vh-80">
    <div class="card shadow-sm p-4 w-100" style="max-width: 400px;">
        <h3 class="mb-3 text-center">@L["Checkin.Title"]</h3>
        <p class="mb-4 text-center text-muted small">@L["Checkin.FillOutOneField"]</p>

        <div class="position-relative">
            <EditForm Model="PhoneNumber" OnValidSubmit="CheckYearcard">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3 text-center">
                    <label for="phoneNumber" class="form-label mb-2">@L["Checkin.PhoneNumber"]</label>
                    <PhoneNumberInput @bind-Value="PhoneNumber.Phone" InputId="phoneNumber" />
                </div>
                <div class="mb-3 text-center">
                    <label for="email" class="form-label mb-2">@L["Checkin.Email"]</label>
                    <input type="text" id="email" @bind="Email.Email"
                           class="form-control w-100 mx-auto text-center" 
                           autocapitalize="none" autocorrect="off" spellcheck="false"  />
                </div>

                <button class="btn btn-primary w-100 mt-2" type="submit">@L["Checkin.CheckInButton"]</button>
            </EditForm>

            @if (HasResult)
            {
                <div class="checkin-overlay">
                    <div class="alert @ResultClass alert-dismissible mb-0 w-100" role="alert">
                        <button type="button" class="btn-close" aria-label="@L["Common.Close"]"
                                @onclick="DismissResult" />
                        @foreach (string line in ResultLines)
                        {
                            <div>@line</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private PhoneNumberCheckInRequest PhoneNumber { get; set; } = new();
    private EmailCheckInRequest Email { get; set; } = new();
    private UsernameCheckInRequest UserName { get; set; } = new();

    private List<string> ResultLines { get; set; } = new();
    private string ResultClass { get; set; } = string.Empty;

    private bool HasResult => ResultLines.Count > 0;

    private async Task CheckYearcard()
    {
        ClearResult();

        try
        {
            (CheckInResponse response, string identifier) = await CheckInAsync();

            if (string.IsNullOrWhiteSpace(identifier))
            {
                return;
            }

            ShowResult(response, identifier);
        }
        catch (HttpRequestException)
        {
            ShowError(L["Checkin.Error.ServiceUnavailable"]);
        }
        catch (Exception ex)
        {
            ShowErrorMessage(ex.Message);
        }
        finally
        {
            ResetInputs();
        }
    }

    private async Task<(CheckInResponse Response, string Identifier)> CheckInAsync()
    {
        CheckInResponse response = new();
        string identifier = string.Empty;

        if (!string.IsNullOrWhiteSpace(PhoneNumber.Phone))
        {
            response = await YearcardService.CheckinWithPhonenumberAsync(PhoneNumber);
            identifier = PhoneNumber.Phone;
        }

        if (!response.IsValid && !string.IsNullOrWhiteSpace(Email.Email))
        {
            response = await YearcardService.CheckinWithEmailAsync(Email);
            identifier = Email.Email;
        }

        if (!response.IsValid && !string.IsNullOrWhiteSpace(UserName.UserName))
        {
            response = await YearcardService.CheckinWithUsernameAsync(UserName);
            identifier = UserName.UserName;
        }

        return (response, identifier);
    }

    private void ShowResult(CheckInResponse response, string identifier)
    {
        string validityText = response.IsValid ? L["Checkin.Valid"] : L["Checkin.Invalid"];

        List<string> lines = new()
        {
            $"{L["Checkin.CardWith"]} {identifier} {validityText}"
        };

        if (response.IsValidForDiscount == IsValidForDiscount.IsValid)
        {
            lines.Add(response.IsValid
                ? L["Checkin.AndValidForDiscount"]
                : L["Checkin.ButValidForDiscount"]);
        }

        lines.Add($"{L["CardId"]}: {response.CardId}");
        lines.Add($"{L["Name"]}: {response.Name}");
        lines.Add($"{L["ExpirationDate"]}: {response.ExpirationDate}");

        ResultClass = response.IsValid ? "alert-success" : "alert-danger";
        ResultLines = lines;
    }

    private void ShowError(LocalizedString message)
    {
        ResultClass = "alert-warning";
        ResultLines = new List<string> { message };
    }

    private void ShowErrorMessage(string message)
    {
        ResultClass = "alert-warning";
        ResultLines = new List<string> { message };
    }

    private void DismissResult() => ClearResult();

    private void ClearResult()
    {
        ResultLines = new List<string>();
        ResultClass = string.Empty;
    }

    private void ResetInputs()
    {
        PhoneNumber = new PhoneNumberCheckInRequest();
        Email = new EmailCheckInRequest();
        UserName = new UsernameCheckInRequest();
    }
}